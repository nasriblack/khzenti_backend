generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Whitelist {
  id        String   @id @default(uuid())
  email     String   @unique
  ipAddress String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ipAddress])
  @@index([email])
  @@map("whitelist")
}

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique
  password              String
  name                  String?
  age                   Int?
  location              String?
  maxWardrobeItems      Int                 @default(7) // how much the user have the limit of items
  maxOutfitGenerations  Int                 @default(5) // how much the user have the limit of generation outfit
  outfitGenerationsUsed Int                 @default(0) // a counter that have the user on outfit generation
  stylePreferences      String[]
  emailVerified         DateTime?
  isActive              Boolean             @default(true)
  isPremium             Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  outfits               Outfit[]
  suggestionHistory     SuggestionHistory[]
  wardrobeItems         WardrobeItem[]

  @@index([email])
  @@map("users")
}

model WardrobeItem {
  id           String       @id @default(cuid())
  userId       String
  imageUrl     String
  category     Category
  colors       String[]
  season       Season       @default(ALL)
  brand        String?
  notes        String?
  styleTags    String[]
  lastWornDate DateTime?
  timesWorn    Int          @default(0)
  isFavorite   Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  outfits      OutfitItem[]
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([category])
  @@index([userId, category])
  @@map("wardrobe_items")
}

model Outfit {
  id                String              @id @default(cuid())
  userId            String
  name              String?
  occasion          Occasion            @default(CASUAL)
  aiExplanation     String?
  notes             String?
  isDailySuggestion Boolean             @default(false)
  isSaved           Boolean             @default(false)
  wornDate          DateTime?
  userFeedback      Feedback?
  rating            Int?                @default(0)
  weatherTemp       Float?
  weatherCondition  String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  items             OutfitItem[]
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  history           SuggestionHistory[]

  @@index([userId])
  @@index([userId, isSaved])
  @@index([userId, isDailySuggestion])
  @@index([wornDate])
  @@map("outfits")
}

model OutfitItem {
  id       String       @id @default(cuid())
  outfitId String
  itemId   String
  position Int          @default(0)
  item     WardrobeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  outfit   Outfit       @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  @@unique([outfitId, itemId])
  @@index([outfitId])
  @@index([itemId])
  @@map("outfit_items")
}

model SuggestionHistory {
  id             String    @id @default(cuid())
  userId         String
  outfitId       String
  suggestionDate DateTime  @default(now())
  wasAccepted    Boolean   @default(false)
  wasWorn        Boolean   @default(false)
  viewedAt       DateTime?
  respondedAt    DateTime?
  outfit         Outfit    @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([suggestionDate])
  @@index([userId, suggestionDate])
  @@map("suggestion_history")
}

enum Category {
  TOPS
  BOTTOMS
  SHOES
  JACKETS
  ACCESSORIES
}

enum Season {
  SUMMER
  WINTER
  SPRING
  FALL
  ALL
}

enum Style {
  CASUAL
  ELEGANT
  SPORT
  STREETWEAR
  VINTAGE
  MINIMAL
}

enum Occasion {
  WORK
  CASUAL
  DATE
  WEDDING
  SPORT
  PARTY
  FORMAL
}

enum Feedback {
  LIKE
  DISLIKE
  NEUTRAL
}
